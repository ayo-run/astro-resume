{
  "name": "monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": "Ayo Ayco",
  "scripts": {
    "dev": "cd demo && npm run dev",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter @ayco/astro-resume test",
    "test:watch": "pnpm --filter @ayco/astro-resume test:watch",
    "check": "pnpm --filter demo check",
    "release": "bumpp package/package.json && git push gh --follow-tags"
  },
  "devDependencies": {
    "@ayco/astro-resume": "workspace:*",
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "astro-eslint-parser": "^1.4.0",
    "bumpp": "^11.0.1",
    "devalue": "^5.9.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.58.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
