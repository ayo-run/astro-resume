---
export interface Props {
  /**
   * The id that the client script will pass to the `deserialize()` function
   */
  id: string;
  /**
   * The data to be serialized and accessed in the client script with `deserialize()`
   */
  data: Record<string, any>;
  /**
   * Custom serializer to be used
   * @param data
   */
  use?: (data: Record<string, any>) => string;
}
const { id, data, use } = Astro.props;
let serializedData = "{}";
try {
  serializedData = use ? use(data) : JSON.stringify(data).replace(/</g, '\\u003c');
} catch (err) {
  /**
   *  ERR: data is unserializable
   *  - You might need a custom serializer/parser for complex data
   *  - Usage examples in 👉 https://ayco.io/gh/astro-resume#usage
   */
  throw Error(
    `astro-resume ERR: Data unserializable
- You might need a custom serializer/parser for complex data
- Usage examples in 👉 https://ayco.io/gh/astro-resume#usage
    `,
    { cause: err }
  );
}

/**
 * Backstop against a breakout. The default serializer escapes every "<", so
 * this can only fire for a custom `use` serializer that does not — whose
 * output is written to the page unchanged, by design, so that serializers
 * which emit their own format are not corrupted.
 *
 * Refusing to render is the safe failure: the alternative is a page that
 * silently executes whatever was in the data.
 */
if (/<\/script/i.test(serializedData)) {
  throw Error(
    `astro-resume ERR: Serialized data contains "</script"
- That would close the script element early and run the rest as HTML
- The default serializer escapes "<", so this came from a custom "use" serializer
- Use one that escapes "<" itself — devalue does
- See 👉 https://ayco.io/gh/astro-resume#escaping--xss
    `
  );
}
---

<script type="application/json" id={id} set:html={serializedData} />
